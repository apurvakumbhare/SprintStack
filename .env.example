# MySQL database (create an empty schema named sprintstack, or allow createDatabaseIfNotExist)
DB_URL=jdbc:mysql://localhost:3306/sprintstack?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=replace-me

# Generate a random 32+ byte secret before enabling JWT authentication
JWT_SECRET=replace-with-a-long-random-secret-before-use
JWT_EXPIRATION_MS=86400000

SERVER_PORT=8080
FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:8080/api
VITE_APP_NAME=SprintStack
